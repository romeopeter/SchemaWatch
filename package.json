{
  "name": "schemawatch",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome DevTools panel extension that infers per-endpoint response schemas and flags breaking contract changes as they happen.",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/make-icons.mjs",
    "build": "vite build",
    "predev": "node scripts/make-icons.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^1.0.6"
  }
}
